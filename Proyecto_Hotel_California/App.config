<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <connectionStrings>
        <!-- Conexión principal - Usar localhost o el nombre de tu servidor -->
        <add name="HotelConnectionString" 
             connectionString="Data Source=localhost\SQLEXPRESS;Initial Catalog=Hotel1;Integrated Security=True" 
             providerName="System.Data.SqlClient" />
        <!-- Conexión alternativa - Puedes cambiar esto por tu servidor específico -->
        <add name="HotelConnectionStringAlt" 
             connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=Hotel1;Integrated Security=True" 
             providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>
